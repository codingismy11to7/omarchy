
# omarchy:summary=Prompt for required reboot or service restarts after updates

# TODO: NixOS kernel update detection
# Upstream uses pacman -Qo + uname -r to detect kernel updates; needs nix-store equivalent.

confirm_reboot() {
  @gum@ confirm "$1" && { omarchy-system-reboot; exit 0; }
}

# TODO: NixOS Hyprland update detection
# Upstream checks readlink /proc/$(pgrep -x Hyprland)/exe for "(deleted)"; on NixOS the
# old store path persists after updates and the process is .Hyprland-wrapped, so that
# check can't work here.

if [[ -f $HOME/.local/state/omarchy/reboot-required ]]; then
  confirm_reboot "Updates require reboot. Ready?"
fi

for file in "$HOME"/.local/state/omarchy/restart-*-required; do
  if [[ -f $file ]]; then
    filename=$(basename "$file")
    service=$(echo "$filename" | @sed@ 's/restart-\(.*\)-required/\1/')
    echo "Restarting $service"
    omarchy-state clear "$filename"
    omarchy-restart-"$service"
  fi
done
